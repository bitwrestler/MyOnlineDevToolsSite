<h3>HH:MM Calculator</h3>

<div class="grid">
    @for (var i = 0; i < EntryCount; i++)
    {
        <HHMMSingleEntry Index="i" />
    }
</div>

<div id="hhmmResult" class="hhmm-result" aria-live="polite"><span class="hhmm-result-value">&mdash;</span> hours</div>

<script src="js/dateTimeTools.js" asp-append-version="true"></script>

@code {
    [Parameter] public int EntryCount { get; set; } = 7;
}
